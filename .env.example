# ---------------------------------------------------------------------------
# WhatsApp Blast SaaS — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (MySQL 8) ----------------------------------------------------
# Prisma 7 reads this through prisma.config.ts for CLI/migrations and through
# the MariaDB driver adapter at runtime.
DATABASE_URL="mysql://wablast:change-me@127.0.0.1:3306/wablast"
# Optional: separate database used by `prisma migrate dev` for drift detection.
SHADOW_DATABASE_URL="mysql://wablast:change-me@127.0.0.1:3306/wablast_shadow"

# --- Redis (BullMQ + rate limiting) ----------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# --- Auth.js / NextAuth v5 -------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Set to "true" behind a reverse proxy (Nginx) terminating TLS.
AUTH_TRUST_HOST="true"

# --- At-rest encryption ----------------------------------------------------
# 32 random bytes, base64 encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"

# --- Cloudflare Turnstile --------------------------------------------------
# Site key is public; the secret key must stay server-side only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Private storage root for target uploads and campaign media.
# Must never be inside `public/`.
PRIVATE_STORAGE_DIR="./storage"

# Bearer token required by /api/health for detailed probes.
HEALTH_CHECK_TOKEN="replace-with-at-least-16-characters"

LOG_LEVEL="info"

# --- Worker process ---------------------------------------------------------
# Unique per worker instance; used as the recipient lease owner.
WORKER_ID="worker-1"
WORKER_CONCURRENCY="4"

# --- Initial admin bootstrap (used only by `npm run db:seed`) --------------
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Platform Admin"
