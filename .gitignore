# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma: generated client is rebuilt by `prisma generate`.
/src/generated/

# Private storage: target uploads, campaign media, device sessions (RULES.md §7)
/storage/
/.tmp-test-storage/

# Test artefacts
/playwright-report
/test-results

# Logs
*.log

# Local verification scratch files
_*.bat
_*.txt
